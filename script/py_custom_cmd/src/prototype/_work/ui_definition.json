  "menus": [
    {
      "title_key": "menu_title",
      "items": [
        {
          "type": "command",
          "label_key": "menu_open",
          "command_name": "event_open_file",
          "accelerator": "Ctrl+O",
          "bind": "<Control-o>"
        },
        {
          "type": "command",
          "label_key": "menu_save",
          "command_name": "event_save_file",
          "accelerator": "Ctrl+S",
          "bind": "<Control-s>"
        },
        {
          "type": "command",
          "label_key": "menu_save_as",
          "command_name": "event_save_file_as",
          "accelerator": "Ctrl+Shift+S",
          "bind": "<Control-Shift-S>"
        },
        {
          "type": "separator"
        },
        {
          "type": "radio",
          "label_key": "rdo_lang_en",
          "command_name": "event_switch_language",
          "variable_name": "current_lang_strvar",
          "value": "en"
        },
        {
          "type": "radio",
          "label_key": "rdo_lang_ja",
          "command_name": "event_switch_language",
          "variable_name": "current_lang_strvar",
          "value": "ja"
        },
        {
          "type": "separator"
        },
        {
          "type": "radio",
          "label_key": "rdo_monitor_on",
          "command_name": "event_switch_monitor",
          "variable_name": "current_monitor_boolvar",
          "value": true
        },
        {
          "type": "radio",
          "label_key": "rdo_monitor_off",
          "command_name": "event_switch_monitor",
          "variable_name": "current_monitor_boolvar",
          "value": false
        },
        {
          "type": "separator"
        },
        {
          "type": "command",
          "label_key": "menu_select_all",
          "command_name": "event_toggle_all_checks",
          "accelerator": "Ctrl+A",
          "bind": "<Control-a>"
        },
        {
          "type": "command",
          "label_key": "menu_deselect_all",
          "command_name": "event_active_deselect_all",
          "accelerator": "Ctrl+Shift+A",
          "bind": "<Control-Shift-A>"
        },
        {
          "type": "separator"
        },
        {
          "type": "command",
          "label_key": "menu_exit",
          "command_name": "event_quit_app",
          "accelerator": "Ctrl+Q",
          "bind": "<Control-q>"
        }
      ]
    }
  ],
  "button_layout": {
    "side": "right",
    "padx": 10,
    "pady": 5
  },
  "buttons": [
    {
      "label_key": "btn_update",
      "command_name": "event_update",
      "grid_layout": {
        "row": 0,
        "column": 0,
        "padx": 5,
        "pady": 5
      }
    },
    {
      "label_key": "btn_download",
      "command_name": "event_download",
      "grid_layout": {
        "row": 0,
        "column": 1,
        "padx": 5,
        "pady": 5
      }
    },
    {
      "label_key": "btn_markdown",
      "command_name": "event_markdown",
      "grid_layout": {
        "row": 0,
        "column": 2,
        "padx": 5,
        "pady": 5
      }
    },
    {
      "label_key": "btn_custom_iso",
      "command_name": "event_custom_iso",
      "grid_layout": {
        "row": 0,
        "column": 3,
        "padx": 5,
        "pady": 5
      }
    },
    {
      "label_key": "btn_custom_live",
      "command_name": "event_custom_live",
      "grid_layout": {
        "row": 0,
        "column": 4,
        "padx": 5,
        "pady": 5
      }
    },
    {
      "label_key": "btn_ipxe_menu",
      "command_name": "event_ipxe_menu",
      "grid_layout": {
        "row": 0,
        "column": 5,
        "padx": 5,
        "pady": 5
      }
    },
    {
      "label_key": "btn_exit",
      "command_name": "event_quit_app",
      "grid_layout": {
        "row": 0,
        "column": 7,
        "padx": 5,
        "pady": 5
      }
    },
    {
      "label_key": "btn_exec",
      "command_name": "event_exec",
      "grid_layout": {
        "row": 0,
        "column": -1,
        "padx": 5,
        "pady": 5
      }
    },
    {
      "label_key": "btn_confirm",
      "command_name": "event_confirm",
      "grid_layout": {
        "row": 0,
        "column": -1,
        "padx": 5,
        "pady": 5
      }
    },
    {
      "label_key": "btn_debug",
      "command_name": "event_debug_mon",
      "grid_layout": {
        "row": 0,
        "column": -1,
        "padx": 5,
        "pady": 5
      }
    }
  ],
  "tables": [
    {
      "table_id": "active_table",
      "label_key": "lbl_table_active",
      "even_bg": "#ffffff",
      "odd_bg": "#f3f4f6",
      "updated_bg": "#e0f2fe",
      "command_select_all": "event_active_select_all",
      "command_deselect_all": "event_active_deselect_all",
      "grid_layout": {
        "row": 0,
        "column": 0,
        "row_span": 1,
        "column_span": 1,
        "padx": 0,
        "pady": 0,
        "sticky": "nsew"
      },
      "columns": [
        {
          "field": "target_flag",
          "width": 16,
          "anchor": "center"
        },
        {
          "field": "mdia_type",
          "width": 64,
          "anchor": "center"
        },
        {
          "field": "entry_disp",
          "width": 240,
          "anchor": "w"
        },
        {
          "field": "release",
          "width": 80,
          "anchor": "center"
        },
        {
          "field": "support",
          "width": 80,
          "anchor": "center"
        },
        {
          "field": "web_tstamp",
          "width": 128,
          "anchor": "center",
          "format": "{:%Y/%m/%d %H:%M}"
        },
        {
          "field": "web_check",
          "width": 128,
          "anchor": "center",
          "format": "{:%Y/%m/%d %H:%M}"
        },
        {
          "field": "memo",
          "width": -1,
          "anchor": "w"
        }
      ]
    }
  ]
}