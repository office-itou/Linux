#!ipxe

# --- Menu block --------------------------------------------------------------
# https://ubuntu.com/project/docs/release-team/list-of-releases/
set edition server
:menu
menu Select the OS type you want to boot
item --gap --                                   [ Return menu ]
item -- return                                  - Return
item --gap --                                   [ Edition ]
item -- server                                  - Server
item -- desktop                                 - Desktop
item -- Ubuntu-26.10                            - Ubuntu ${edition} 26.10 (Stonking Stingray)
item -- Ubuntu-26.04                            - Ubuntu ${edition} 26.04 (Resolute Raccoon)
item -- Ubuntu-24.04                            - Ubuntu ${edition} 24.04 (Noble Numbat)
item -- Ubuntu-22.04                            - Ubuntu ${edition} 22.04 (Jammy Jellyfish)
item -- Ubuntu-20.04                            - Ubuntu ${edition} 20.04 (Focal Fossa)
item -- Ubuntu-18.04                            - Ubuntu ${edition} 18.04 (Bionic Beaver)
item -- Ubuntu-16.04                            - Ubuntu ${edition} 16.04 (Xenial Xerus)
item -- Ubuntu-14.04                            - Ubuntu ${edition} 14.04 (Trusty Tahr)
item -- Ubuntu-12.04                            - Ubuntu ${edition} 12.04 (Precise Pangolin)
choose --default ${selected} selected           || goto menu
iseq ${selected} return                         && goto return         ||
iseq ${selected} server                         && set edition server  ||
iseq ${selected} desktop                        && set edition desktop ||
iseq ${selected} Ubuntu-26.10                   && goto Ubuntu-26.10
iseq ${selected} Ubuntu-26.04                   && goto Ubuntu-26.04
iseq ${selected} Ubuntu-24.04                   && goto Ubuntu-24.04
iseq ${selected} Ubuntu-22.04                   && goto Ubuntu-22.04
iseq ${selected} Ubuntu-20.04                   && goto Ubuntu-20.04
iseq ${selected} Ubuntu-18.04                   && goto Ubuntu-18.04
iseq ${selected} Ubuntu-16.04                   && goto Ubuntu-16.04
iseq ${selected} Ubuntu-14.04                   && goto Ubuntu-14.04
iseq ${selected} Ubuntu-12.04                   && goto Ubuntu-12.04
goto menu

:Ubuntu-26.10
:Ubuntu-26.04
:Ubuntu-24.04
:Ubuntu-22.04
:Ubuntu-20.04
:Ubuntu-18.04
:Ubuntu-16.04
:Ubuntu-14.04
:Ubuntu-12.04
clear vers
iseq ${selected} Ubuntu-26.10                   && set vers 26.10 ||
iseq ${selected} Ubuntu-26.04                   && set vers 26.04 ||
iseq ${selected} Ubuntu-24.04                   && set vers 24.04 ||
iseq ${selected} Ubuntu-22.04                   && set vers 22.04 ||
iseq ${selected} Ubuntu-20.04                   && set vers 20.04 ||
iseq ${selected} Ubuntu-18.04                   && set vers 18.04 ||
iseq ${selected} Ubuntu-16.04                   && set vers 16.04 ||
iseq ${selected} Ubuntu-14.04                   && set vers 14.04 ||
iseq ${selected} Ubuntu-12.04                   && set vers 12.04 ||
isset ${vers}                                   || goto menu
iseq ${edition} server                          && goto ubuntu-server  ||
iseq ${edition} desktop                         && goto ubuntu-desktop ||
goto menu

:ubuntu-server
set messages Loading Ubuntu ${vers} Server ...
set parmauto automatic-ubiquity noprompt autoinstall cloud-config-url=/dev/null ds=nocloud;s=${srvrhttp}/conf/nocloud/ubuntu_server
set imgsdirs ${srvrhttp}/imgs/ubuntu-live-${vers}
set exptdirs ${srvraddr}:/srv/exports/nfs/imgs/ubuntu-live-${vers}
goto ubuntu-common

:ubuntu-desktop
set messages Loading Ubuntu ${vers} Desktop ...
set parmauto automatic-ubiquity noprompt autoinstall cloud-config-url=/dev/null ds=nocloud;s=${srvrhttp}/conf/nocloud/ubuntu_desktop
set imgsdirs ${srvrhttp}/imgs/ubuntu-desktop-${vers}
set exptdirs ${srvraddr}:/srv/exports/nfs/imgs/ubuntu-desktop-${vers}
goto ubuntu-common

:ubuntu-common
set kernlopt ${imgsdirs}/casper/vmlinuz
set inirdopt ${imgsdirs}/casper/initrd
set hnameopt sv-ubuntu.workgroup
set enameopt ens160
set languopt language=ja country=JP timezone=Asia/Tokyo keyboard-configuration/xkb-keymap=jp keyboard-configuration/variant=Japanese
set otheropt netboot=nfs nfsroot=${exptdirs} network-config=disabled --- quiet vga=788
set consoles dummy_console=tty0 dummy_console=ttyS0,9600
set sulogins SYSTEMD_SULOGIN_FORCE=1 dummy_init=/sbin/sulogin
set debugopt ${consoles} ${sulogins}
echo "Loading menu/booting.ipxe ..."
chain --autofree --replace ${ipxebase}/menu/booting.ipxe && exit ||
goto menu

# --- system control ----------------------------------------------------------
:shell
echo "Booting iPXE shell ..."
shell
goto menu

:shutdown
echo "System shutting down ..."
poweroff
exit

:restart
echo "System rebooting ..."
reboot
exit

:return
echo "Return ..."
chain ${ipxebase}/menu/menu.ipxe
goto menu

:exit
exit

:error
prompt Press any key to continue
exit

# --- eof ---------------------------------------------------------------------
