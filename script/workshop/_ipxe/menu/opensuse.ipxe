#!ipxe

# --- Menu block --------------------------------------------------------------
# https://en.opensuse.org/openSUSE:Roadmap
set edition server
:menu
menu Select the OS type you want to boot
item --gap --                                   [ Return menu ]
item -- return                                  - Return
item --gap --                                   [ Edition ]
item -- server                                  - Server
item -- desktop                                 - Desktop
#item --gap --                                   [ Development ]
item --gap --                                   [ Current (supported) ]
item -- 16.0                                    - openSUSE  ${edition} 16.0
#item --gap --                                   [ End of life (unsupported) ]
choose --default ${selected} selected || goto menu
iseq ${selected} server  && goto edition ||
iseq ${selected} desktop && goto edition ||
iseq ${selected} return  && goto return  ||
isset ${selected} && goto opensuse-leap-${selected} ||
goto menu

:edition
iseq ${selected} server  && set edition server ||
iseq ${selected} desktop && set edition desktop ||
goto menu

:opensuse-leap-16.0
set vers ${selected}
isset ${vers} || goto menu
iseq ${edition} server  && goto opensuse-leap-server ||
iseq ${edition} desktop && goto opensuse-leap-desktop ||
goto menu

:opensuse-leap-server
set messages Loading openSUSE  ${vers} Server ...
set imgsdirs ${srvrhttp}/imgs/opensuse-leap-netinst-${vers}
set exptdirs ${srvraddr}:/srv/exports/nfs/imgs/opensuse-leap-netinst-${vers}
set autoinst live.password=install inst.auto=${srvrhttp}/conf/agama/autoinst_leap-${vers}.json
goto booting

:opensuse-leap-desktop
set messages Loading openSUSE  ${vers} Desktop ...
set imgsdirs ${srvrhttp}/imgs/opensuse-leap-netinst-${vers}
set exptdirs ${srvraddr}:/srv/exports/nfs/imgs/opensuse-leap-netinst-${vers}
set autoinst live.password=install inst.auto=${srvrhttp}/conf/agama/autoinst_leap-${vers}_desktop.json
goto booting

:booting
prompt --key e --timeout ${optn-timeout} Press 'e' to open edit menu ... && set openmenu 1 ||
set hostname sv-opensuse-leap.workgroup
set ethrname ens160
set ipv4addr 192.168.1.1
set ipv4mask 255.255.255.0
set ipv4gway 192.168.1.254
set ipv4nsvr 192.168.1.254
form                                    Configure Network Options
item hostname                           Hostname
item ethrname                           Interface
item ipv4addr                           IPv4 address/netmask
item ipv4gway                           IPv4 gateway
item ipv4nsvr                           IPv4 nameservers
isset ${openmenu} && present ||
#set autoinst live.password=install inst.auto=${srvrhttp}/conf/agama/autoinst_leap-${vers}.json
set language language=ja_JP
set networks netsetup=dhcp hostname=${hostname} ifcfg=${ethrname}=${ipv4addr},${ipv4gway},${ipv4nsvr},workgroup
set otheropt root=live:${srvrhttp}/isos/linux/opensuse/Leap-${vers}-online-installer-x86_64.install.iso --- quiet vga=788
set kernlopt ${imgsdirs}/boot/x86_64/loader/linux
set inirdopt ${imgsdirs}/boot/x86_64/loader/initrd
set consoles dummy_console=tty0 dummy_console=ttyS0,9600
set sulogins SYSTEMD_SULOGIN_FORCE=1 dummy_init=/sbin/sulogin
#set debugopt ${consoles} ${sulogins}
form                                    Configure Autoinstall Options
item autoinst                           Auto install
item language                           Language
item networks                           Network
item otheropt                           Other options
#item debugopt                           Debug options
isset ${openmenu} && present ||
set options ${autoinst} ${language} ${networks} ${otheropt} ${debugopt}
echo ${messages}
echo Loading boot files ...
kernel ${kernlopt} ${options} || goto error
initrd ${inirdopt} || goto error
boot || goto error
exit

:return
echo "Return ..."
chain ${ipxebase}/menu/menu.ipxe
goto menu

:exit
exit

:error
prompt Press any key to continue
exit
